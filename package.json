{
  "name": "rcb-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "rcb (Remember · Connect · Build) — local-first repo dashboard and agent-driven Kanban board",
  "license": "MIT",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run && pnpm --filter @rcb/web check:size",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/node": "^26.4.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
